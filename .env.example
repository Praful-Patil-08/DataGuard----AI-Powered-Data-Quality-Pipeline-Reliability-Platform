# Environment Configuration
DATABASE_URL=postgresql://dataguard:dataguard@localhost:5432/dataguard
# AI Provider: mock | openai | gemini (auto-detected if key is set)
AI_PROVIDER=mock
# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# API Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Web Client
NEXT_PUBLIC_API_URL=http://localhost:8000
